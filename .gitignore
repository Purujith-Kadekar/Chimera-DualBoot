# ---- PlatformIO build output (every project folder) ----
.pio/
**/.pio/
.pioenvs/
.piolibdeps/

# ---- Generated ESP-IDF config (PlatformIO rewrites these on every build) ----
# Keep sdkconfig.defaults -- that is the hand-written source of truth.
sdkconfig.*
!sdkconfig.defaults
sdkconfig
sdkconfig.old
dependencies.lock
managed_components/

# ---- Build / release artifacts ----
build/
release/
*.elf
*.map
edgehax_all.bin
*_merged.bin

# ---- Editors / IDEs ----
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/
*.code-workspace
*.swp
*~

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Python (helper scripts) ----
__pycache__/
*.pyc

# ---- Logs ----
*.log

# ---- Anything private: keep real vault data and secrets out of git ----
vault.db
vault.db.*
*.pem
*.key
.env
